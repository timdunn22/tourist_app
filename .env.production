# LocalLink Production Environment Variables
# Copy this to .env and fill in your actual values

# ===========================================
# DATABASE (Railway provides this)
# ===========================================
DATABASE_URL=postgresql://user:password@host:5432/railway

# ===========================================
# REDIS (Railway provides this)
# ===========================================
REDIS_URL=redis://default:password@host:6379

# ===========================================
# JWT AUTH (Generate secure random strings)
# Run: openssl rand -base64 32
# ===========================================
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# ===========================================
# APP URLS (Update with your actual domains)
# ===========================================
APP_URL=https://locallink.app
ADMIN_URL=https://admin.locallink.app
API_URL=https://api.locallink.app

# ===========================================
# CORS (Add all your frontend domains)
# ===========================================
CORS_ORIGINS=https://locallink.app,https://admin.locallink.app

# ===========================================
# STRIPE PAYMENTS (Get from Stripe Dashboard)
# https://dashboard.stripe.com/apikeys
# ===========================================
STRIPE_SECRET_KEY=sk_live_XXXXX
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXX

# ===========================================
# GOOGLE MAPS (Get from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
# ===========================================
GOOGLE_MAPS_API_KEY=AIzaSyXXXXX

# ===========================================
# AWS S3 (For file uploads)
# Create IAM user with S3 access
# ===========================================
AWS_ACCESS_KEY_ID=AKIAXXXXX
AWS_SECRET_ACCESS_KEY=XXXXX
AWS_S3_BUCKET=locallink-uploads
AWS_REGION=us-east-1

# ===========================================
# EMAIL (SendGrid recommended)
# https://app.sendgrid.com/settings/api_keys
# ===========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.XXXXX
EMAIL_FROM=LocalLink <noreply@locallink.app>

# ===========================================
# FIREBASE (For Push Notifications)
# https://console.firebase.google.com
# ===========================================
FIREBASE_PROJECT_ID=locallink-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@locallink-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"

# ===========================================
# TWILIO (For SMS - Optional)
# https://console.twilio.com
# ===========================================
TWILIO_ACCOUNT_SID=ACXXXXX
TWILIO_AUTH_TOKEN=XXXXX
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# ADMIN DEFAULTS
# ===========================================
ADMIN_EMAIL=admin@locallink.app
ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_GPS_TRACKING=true
ENABLE_REVIEWS=true
ENABLE_STAYS=true
ENABLE_SERVICES=true

# ===========================================
# COMMISSION SETTINGS
# ===========================================
PLATFORM_COMMISSION_RATE=15
MIN_BOOKING_ADVANCE_HOURS=24
