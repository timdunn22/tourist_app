# LocalLink Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://locallink:locallink_secret@localhost:5432/locallink

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# JWT AUTH
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# ===========================================
# APP URLS
# ===========================================
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================================
# STRIPE PAYMENTS
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===========================================
# GOOGLE MAPS
# ===========================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ===========================================
# AWS S3 (for file uploads)
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=locallink-uploads
AWS_REGION=us-east-1

# ===========================================
# EMAIL (SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=LocalLink <noreply@locallink.app>

# ===========================================
# FIREBASE (Push Notifications)
# ===========================================
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===========================================
# TWILIO (SMS)
# ===========================================
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# ADMIN DEFAULTS
# ===========================================
ADMIN_EMAIL=admin@locallink.app
ADMIN_PASSWORD=LocalLink2024!

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_GPS_TRACKING=true
ENABLE_REVIEWS=true
ENABLE_STAYS=true
ENABLE_SERVICES=true

# ===========================================
# COMMISSION SETTINGS
# ===========================================
PLATFORM_COMMISSION_RATE=15
MIN_BOOKING_ADVANCE_HOURS=24
